# ============================================================
# OOPSY — Environment Variables
#
# Copy this file to .env.local to configure local development:
#   cp .env.example .env.local
# ============================================================

# ── Google Analytics 4 (GA4) ──
# Measurement ID provided in Google Analytics (e.g., G-XXXXXXXXXX)
# When set, the gtag.js tracking script is automatically loaded.
# When absent or empty, the application functions normally without tracking.
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ── Google Search Console Verification ──
# Verification token provided in Google Search Console HTML tag method.
# When set, injects <meta name="google-site-verification" content="..." /> into the root document head.
# When absent or empty, no verification tag is rendered.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-verification-token-here

# ── Canonical Website URL ──
# Canonical base URL for sitemap.xml, robots.txt, OpenGraph, and JSON-LD structured data.
# Defaults to https://oopsy.cl if not specified.
NEXT_PUBLIC_SITE_URL=https://oopsy.cl

# ── Resend Email Service ──
# API key for Resend email delivery (used by /api/contact endpoint).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# ── Portafolio Editorial & Talentos (CMS Headless: Google Sheets) ──
# ID de la hoja de cálculo de Google Sheets con los metadatos del portafolio.
GOOGLE_SHEETS_PORTFOLIO_ID=1m3BxCEZQ1w_Wk09raXg_ohr4DJRc8MENPPWDXQBXRIE

# Rango de celdas a consultar cuando se usa Google Sheets API v4 (opcional).
GOOGLE_SHEETS_PORTFOLIO_RANGE=A1:K100

# API Key de Google Cloud con permiso de lectura para Google Sheets API v4 y Drive API (solo Build Time).
# Si la hoja está publicada como CSV de lectura, esta clave es opcional.
GOOGLE_SHEETS_API_KEY=your-google-sheets-api-key

# URL directa de exportación CSV de Google Sheets (opcional, se autogenera desde GOOGLE_SHEETS_PORTFOLIO_ID si se omite).
GOOGLE_SHEETS_CSV_URL=https://docs.google.com/spreadsheets/d/1m3BxCEZQ1w_Wk09raXg_ohr4DJRc8MENPPWDXQBXRIE/export?format=csv

# URLs opcionales de exportación CSV para la pestaña de Talentos y Packages de Casting Privado (Ley N° 21.719)
GOOGLE_SHEETS_TALENTS_CSV_URL=your-talents-sheet-csv-url
GOOGLE_SHEETS_CASTING_CSV_URL=your-casting-packages-sheet-csv-url

# ── Gestión, Optimización y Firma Criptográfica de Imágenes (Cloudinary) ──
# Nunca se hace hotlinking directo a Google Drive en el cliente.
# Opción A: Cloudinary (transformación automática WebP/AVIF f_auto,q_auto,fl_strip_profile)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your-cloud-name
NEXT_PUBLIC_CLOUDINARY_FOLDER=oopsy/portfolio

# Credenciales privadas de servidor para generar Cloudinary Signed URLs con expiración corta (15-30 min) en /casting/[token]
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Opción B: Dominio base de CDN dedicado (Cloudflare R2 / S3 / Vercel Blob) donde se sincronizan las carpetas Drive en WebP/AVIF.
NEXT_PUBLIC_PORTFOLIO_CDN_URL=https://cdn.oopsy.cl/portfolio

# ── Vercel Deploy Hook (Automatización SSG) ──
# URL del Deploy Hook en Vercel para disparar un nuevo build estático cuando se actualice el Google Sheet.
VERCEL_DEPLOY_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/prj_xxxxxxx/xxxxxxxx
